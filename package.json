{
  "name": "developer-portfolio-webgl",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "compress:model": "gltf-transform optimize input.glb output.glb --compress draco --texture-compress webp && gltf-pipeline -i output.glb -o public/models/artifact.glb -d --draco.compressionLevel 7",
    "compress:draco": "gltf-pipeline -i input.glb -o public/models/artifact-draco.glb -d --draco.compressionLevel 10",
    "compress:webp": "gltf-transform webp input.glb public/models/artifact-webp.glb",
    "gltf:types": "gltfjsx public/models/artifact.glb --types --transform"
  },
